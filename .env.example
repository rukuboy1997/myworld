# Copy to .env for local development. Never commit real credentials.
PORT=3001

# Required for API/database startup
NEON_DATABASE_URL=
JWT_SECRET=
CORS_ORIGIN=http://localhost:5000

# Cloudflare R2 media storage
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_R2_BUCKET=myworld
CF_R2_PUBLIC_BASE=
BACKEND_URL=http://localhost:3001

# Firebase Realtime Database URL
FIREBASE_DB_URL=https://fascoin-app-default-rtdb.firebaseio.com

# Server-only Firebase service-account JSON for custom-token issuance and realtime writes.
# Store the complete compact JSON as one environment-variable value on the API deployment.
# NEVER prefix this variable with VITE_ or expose it to the frontend.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Email is logged to the server console when RESEND_API_KEY is not configured
RESEND_API_KEY=
EMAIL_FROM=myWorld <myworld@example.com>

# Used by the scheduled status cleanup endpoint
CRON_SECRET=
