# Copy to .env for local development. Never commit real credentials.
PORT=3001

# Required for API/database startup
NEON_DATABASE_URL=
JWT_SECRET=
CORS_ORIGIN=http://localhost:5000

# Cloudflare R2 media storage
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_R2_BUCKET=myworld
CF_R2_PUBLIC_BASE=
BACKEND_URL=http://localhost:3001

# Firebase Realtime Database URL (frontend Firebase config is currently configured in source)
FIREBASE_DB_URL=https://YOUR_PROJECT-default-rtdb.firebaseio.com

# Email is logged to the server console when RESEND_API_KEY is not configured
RESEND_API_KEY=
EMAIL_FROM=myWorld <myworld@example.com>

# Used by the scheduled status cleanup endpoint
CRON_SECRET=
