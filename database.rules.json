{
  "rules": {
    "conversations": {
      "$conversationId": {
        ".read": "auth != null && root.child('conversationMembers').child($conversationId).child(auth.uid).val() === true",
        ".write": false
      }
    },
    "conversationMembers": {
      ".read": false,
      ".write": false
    },
    "presence": {
      "$address": {
        ".read": "auth != null",
        ".write": false
      }
    }
  }
}
